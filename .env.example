# SAR-AI Environment Configuration Example

# LLM Provider Configuration
# Options: 'ollama' or 'gemini'
LLM_PROVIDER=gemini

# Ollama Settings (Privacy-Preserving Local Inference)
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# Gemini Settings (Cloud Inference - Do not use with private data unless explicitly approved)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Storage Configuration
# Options: 'sqlite' or 'jsonl'
STORAGE_BACKEND=sqlite
SAR_DB_PATH=sar_data.db
AUDIT_LOG_PATH=audit_trail.jsonl

# Logging
LOG_LEVEL=INFO
